# Copy to .env and fill in. docker compose reads it automatically.

# Required
POSTGRES_PASSWORD=change-me
DEALRADAR_SECRET_KEY=change-me-long-random-string

# Public URLs. The browser talks to the API directly, so these must be reachable from the user's browser.
PUBLIC_API_URL=http://localhost:8000
DEALRADAR_CORS_ORIGINS=http://localhost:3000

# Optional. EVENT_MODE: NORMAL or BLACK_FRIDAY (halves scan intervals)
DEALRADAR_EVENT_MODE=NORMAL
DEALRADAR_TELEGRAM_BOT_TOKEN=
DEALRADAR_LOG_LEVEL=INFO
# Amazon AU is only enabled when all three are set (Product Advertising API 5.0 + Associates tag)
DEALRADAR_AMAZON_PAAPI_ACCESS_KEY=
DEALRADAR_AMAZON_PAAPI_SECRET_KEY=
DEALRADAR_AMAZON_PAAPI_PARTNER_TAG=
